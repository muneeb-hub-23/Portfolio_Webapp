<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- =======================
         HANDLERS
    ======================== -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- =======================
         STATIC CONTENT
    ======================== -->
    <staticContent>
      <!-- Only add MIME types that IIS does NOT already have -->
      <mimeMap fileExtension=".webp" mimeType="image/webp" />

      <!-- Fix SVG handling -->
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <!-- =======================
         URL REWRITE RULES
    ======================== -->
    <rewrite>
      <rules>

        <!-- Node Inspector (optional) -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js/debug[\/]?" />
          <action type="Rewrite" url="http://localhost:8080/debug?port=5858" />
        </rule>

        <!-- Serve existing physical files (uploads, public assets, etc.) -->
        <rule name="ServeStaticFiles" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Prevent rewrite loop for server.js -->
        <rule name="AvoidServerJSRewriteLoop" stopProcessing="true">
          <match url="^server\.js$" />
          <action type="None" />
        </rule>

        <!-- Everything else → Node.js -->
        <rule name="NodeAll" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>

      </rules>
    </rewrite>

    <!-- =======================
         SECURITY
    ======================== -->
    <security>
      <requestFiltering>
        <!-- Upload file size limit: 50MB -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <!-- =======================
         MODULES
    ======================== -->
    <modules runAllManagedModulesForAllRequests="false">
      <remove name="WebDAVModule" />
      <remove name="WebSocketModule" />
    </modules>

    <!-- Disable folder browsing -->
    <directoryBrowse enabled="false" />

    <!-- =======================
         IISNODE CONFIG
    ======================== -->
    <iisnode
      loggingEnabled="true"
      devErrorsEnabled="true"
      nodeProcessCommandLine="&quot;%programfiles%\nodejs\node.exe&quot;"
      nodeProcessCountPerApplication="1"
      maxConcurrentRequestsPerProcess="1024"
      watchedFiles="*.js;web.config;iisnode.yml"
    />

  </system.webServer>
</configuration>
