# ============================================================
# Portfolio Webapp — Docker Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- External Database (no DB container — set your remote host) ---
DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_USER=portfolio_user
DB_PASSWORD=your_secure_password
DB_NAME=portfolio_db

# --- JWT ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=24h

# --- Service Ports (host-side) ---
BACKEND_PORT=5000
FRONTEND_PORT=80

# --- Frontend API URL (used at build time by Vite) ---
# If frontend and backend run on the same host/domain, use /api (nginx proxy).
# For a separate API domain, set the full URL, e.g. https://api.example.com/api
VITE_API_URL=/api
VITE_BACKEND_URL=/api
